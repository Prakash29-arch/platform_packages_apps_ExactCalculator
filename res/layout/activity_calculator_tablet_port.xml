<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/display_background_color"
    android:orientation="vertical">

    <!-- Takes all the space the keypad does not need. -->
    <include
        layout="@layout/display_ios"
        android:layout_width="match_parent"
        android:layout_height="0dip"
        android:layout_weight="1" />

    <!-- Compact scientific keys, shown with the calculator button in the header. -->
    <include layout="@layout/pad_sci" />

    <!-- Height is computed in CalculatorPadViewPager so the keys are round. -->
    <com.android.calculator2.CalculatorPadViewPager
        android:id="@+id/pad_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        android:tag="square_cells">

        <include layout="@layout/pad_ios" />

    </com.android.calculator2.CalculatorPadViewPager>

</LinearLayout>
